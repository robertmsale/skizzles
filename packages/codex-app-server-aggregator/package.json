{
  "name": "@skizzles/codex-app-server-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codex-app-server-aggregator": "./src/cli.ts",
    "codex-app-server-ctl": "./src/http-cli.ts"
  },
  "scripts": {
    "build": "vite build",
    "check": "bun run typecheck && bun test",
