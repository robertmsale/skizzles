{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/approve-safe-operations.ts\"",
            "timeout": 3,
            "statusMessage": "checking local development permission policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|collaborationspawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/guard-spawn-agent-fork.ts\"",
            "timeout": 3,
            "statusMessage": "checking spawn-agent fork policy"
          }
        ]
      }
    ]
  }
}
