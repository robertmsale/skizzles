{
  "version": 1,
  "capabilities": {
    "luna_high": { "model": "gpt-5.6-luna", "reasoningEffort": "high" },
    "luna_xhigh": { "model": "gpt-5.6-luna", "reasoningEffort": "xhigh" },
    "terra_medium": { "model": "gpt-5.6-terra", "reasoningEffort": "medium" },
    "sol_medium": { "model": "gpt-5.6-sol", "reasoningEffort": "medium" },
    "sol_high": { "model": "gpt-5.6-sol", "reasoningEffort": "high" },
    "sol_xhigh": { "model": "gpt-5.6-sol", "reasoningEffort": "xhigh" }
  },
  "routes": {},
  "nativeRoleAliases": { "explorer": "triage" },
  "roles": [
    {
      "behavior": "default",
      "description": "General Skizzles subagent with a compact developer-focused execution contract.",
      "defaultCapability": "luna_high",
      "capabilities": ["luna_high"]
    },
    {
      "behavior": "triage",
      "description": "Evidence-first diagnosis, runtime reproduction, and implementation-path mapping.",
      "defaultCapability": "terra_medium",
      "capabilities": ["terra_medium"]
    },
    {
      "behavior": "worker",
      "description": "Bounded implementation ownership through focused validation and evidence.",
      "defaultCapability": "luna_xhigh",
      "capabilities": ["luna_xhigh"]
    },
    {
      "behavior": "designer",
      "description": "Frontend and product UI implementation with visual and accessibility proof.",
      "defaultCapability": "sol_medium",
      "capabilities": ["sol_medium"]
    },
    {
      "behavior": "qa",
      "description": "Runtime piloting and evidence-rich product verification without silent fixes.",
      "defaultCapability": "terra_medium",
      "capabilities": ["terra_medium"]
    },
    {
      "behavior": "review",
      "description": "Independent adversarial review, verification, and acceptance assessment.",
      "defaultCapability": "sol_high",
      "capabilities": ["sol_high"]
    },
    {
      "behavior": "deployment",
      "description": "Authorized deployment and production-adjacent procedures with rollback discipline.",
      "defaultCapability": "sol_xhigh",
      "capabilities": ["sol_xhigh"]
    }
  ]
}
